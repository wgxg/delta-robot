(* ============================================================================
   文件名称 : DeltaTypes.st
   功能描述 : Delta 机器人运动控制相关的数据类型定义
   ============================================================================ *)

(* ----------------------------------------------------------------------------
   运动指令结构体
   ---------------------------------------------------------------------------- *)
TYPE st_MoveCmd :
STRUCT
    MoveType    : INT;      (* 运动类型：0=PTP  1=LIN  2=CIR                *)
    PosX        : REAL;     (* 目标位置 X (mm)                               *)
    PosY        : REAL;     (* 目标位置 Y (mm)                               *)
    PosZ        : REAL;     (* 目标位置 Z (mm)                               *)
    AuxX        : REAL;     (* 圆弧辅助点 X（圆心式=圆心，三点式=中间点）    *)
    AuxY        : REAL;     (* 圆弧辅助点 Y                                  *)
    AuxZ        : REAL;     (* 圆弧辅助点 Z                                  *)
    CirMode     : INT;      (* 圆弧模式：0=圆心式  1=三点式                 *)
    Speed       : REAL;     (* 最大速度 (mm/s)                               *)
    Accel       : REAL;     (* 最大加速度 (mm/s²)                            *)
    Jerk        : REAL;     (* 最大加加速度 (mm/s³)，S曲线用                 *)
    MoveMode    : INT;      (* 加减速模式：0=梯形T曲线  1=S曲线             *)
    BufferMode  : INT;      (* 指令处理模式：0=拒绝 1=打断 2=缓存            *)
END_STRUCT
END_TYPE


(* ----------------------------------------------------------------------------
   运动状态枚举
   ---------------------------------------------------------------------------- *)
TYPE e_MoveState :
(
    MOVE_IDLE   := 0,     (* 空闲                                         *)
    MOVE_ACCEL  := 1,     (* 加速                                         *)
    MOVE_CONST  := 2,     (* 匀速                                         *)
    MOVE_DECEL  := 3,     (* 减速                                         *)
    MOVE_DONE   := 4      (* 完成                                         *)
);
END_TYPE
